#!/usr/bin/env bash
# Fail if a StartKin manifest contains secret patterns anywhere (including evidence strings) or a copy item
# whose path the secrets policy denies. Never prints the matched text. See docs/secrets-policy.md.
# Usage: check-manifest-secrets <manifest.json>
# Exit 0 = clean, 1 = findings, 2 = usage/tooling error.
set -uo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/secrets.sh
source "$root/lib/secrets.sh"

if (($# != 1)); then
  echo "usage: check-manifest-secrets <manifest.json>" >&2
  exit 2
fi
file=$1
if [[ ! -f $file ]]; then
  echo "check-manifest-secrets: no such file: $file" >&2
  exit 2
fi
command -v jq >/dev/null 2>&1 || { echo "check-manifest-secrets: jq is required" >&2; exit 2; }

bad=0
rc=0
out=$(secrets_scan_file "$file") || rc=$?
if ((rc == 2)); then exit 2; fi
if ((rc == 1)); then
  bad=1
  while IFS=$'\t' read -r kind line; do
    printf '%s:%s: secret pattern (%s)\n' "$file" "$line" "$kind" >&2
  done <<<"$out"
fi

# Copy items name a file to ship verbatim: the path itself must not be one the policy denies.
if ! paths=$(jq -r '.items[]? | .install? | select(type == "object" and .type == "copy") | .path' "$file" 2>/dev/null); then
  echo "check-manifest-secrets: not valid JSON: $file" >&2
  exit 2
fi
while IFS= read -r p; do
  [[ -n $p ]] || continue
  if cat=$(secrets_path_denied "$p"); then
    bad=1
    printf '%s: copy item path is denied by the secrets policy (%s): %s\n' "$file" "$cat" "$p" >&2
  fi
done <<<"$paths"

exit "$bad"
