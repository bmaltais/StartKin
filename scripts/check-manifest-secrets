#!/usr/bin/env bash
# Fail if a StartKin manifest contains secret patterns anywhere (including evidence strings) or a copy item
# whose path the secrets policy denies. Never prints the matched text. See docs/secrets-policy.md.
# The check itself is secrets_check_manifest (lib/secrets.sh), which `startkin scan --json` also runs before printing.
# Usage: check-manifest-secrets <manifest.json>
# Exit 0 = clean, 1 = findings, 2 = usage/tooling error.
set -uo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/secrets.sh
source "$root/lib/secrets.sh"

if (($# != 1)); then
  echo "usage: check-manifest-secrets <manifest.json>" >&2
  exit 2
fi
file=$1
if [[ ! -f $file ]]; then
  echo "check-manifest-secrets: no such file: $file" >&2
  exit 2
fi
command -v jq >/dev/null 2>&1 || { echo "check-manifest-secrets: jq is required" >&2; exit 2; }

rc=0
out=$(secrets_check_manifest "$file") || rc=$?
case $rc in
  0) exit 0 ;;
  1)
    while IFS=$'\t' read -r kind loc; do
      printf '%s: secret pattern or denied path (%s) at %s\n' "$file" "$kind" "$loc" >&2
    done <<<"$out"
    exit 1
    ;;
  *) echo "check-manifest-secrets: not valid JSON: $file" >&2; exit 2 ;;
esac
