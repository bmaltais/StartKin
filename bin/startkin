#!/usr/bin/env bash
# startkin: dispatcher. Subcommands are scan, adopt, track, export, apply, peers; see `startkin --help` and docs/engine.md.
set -uo pipefail

STARTKIN_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export STARTKIN_ROOT
# shellcheck source=../lib/common.sh
source "$STARTKIN_ROOT/lib/common.sh"
# shellcheck source=../lib/machine.sh
source "$STARTKIN_ROOT/lib/machine.sh"
# shellcheck source=../lib/registry.sh
source "$STARTKIN_ROOT/lib/registry.sh"
# shellcheck source=../lib/scan.sh
source "$STARTKIN_ROOT/lib/scan.sh"
# shellcheck source=../lib/ui.sh
source "$STARTKIN_ROOT/lib/ui.sh"
# shellcheck source=../lib/adopt.sh
source "$STARTKIN_ROOT/lib/adopt.sh"
# shellcheck source=../lib/track.sh
source "$STARTKIN_ROOT/lib/track.sh"
# shellcheck source=../lib/peers.sh
source "$STARTKIN_ROOT/lib/peers.sh"

usage() {
  cat <<'EOF'
Usage: startkin <command> [options]

Commands:
  scan [--json | --report] [--probe]
                  Detect what was added after the Omarchy install (--json: print the manifest;
                  --report: print provenance counts instead;
                  --probe: also run unowned CLI binaries with --version/--help, off by default)
  adopt           Confirm where untraced items came from (see docs/adopt.md)
  track install  Run an install and record its source, version and date
  export          Turn a manifest into a profile / install plan
  apply           Reproduce a manifest on this machine
  peers [--json] [--no-probe]
                  List Tailscale peers (Linux) and the startkin version each online one runs
  peers fetch PEER
                  Print PEER's manifest (runs `startkin scan --json` over SSH)

Options:
  --version       Print the version
  -h, --help      Print this help

Implemented so far: --version, --help, `scan --json`, adopt, track, peers.
EOF
}

not_implemented() { die -c 2 "$1: not implemented"; }

cmd_scan() {
  local json=0 report=0 a
  for a in "$@"; do
    case $a in
      --json) json=1 ;;
      --report) report=1 ;;
      --probe) export STARTKIN_PROBE=1 ;;
      *) die -c 2 "scan: unknown option: $a" ;;
    esac
  done
  ((json && report)) && die -c 2 "scan: --json and --report are exclusive"
  ((json || report)) || not_implemented scan
  require_cmd jq
  if ((report)); then
    local rc=0
    scan_collect | prov_report
    rc=${PIPESTATUS[0]}
    return "$rc"
  fi
  scan_manifest
}

main() {
  case ${1:-} in
    --version) echo "startkin $(version)" ;;
    -h | --help) usage ;;
    scan) shift; cmd_scan "$@" ;;
    adopt) shift; cmd_adopt "$@" ;;
    track) shift; cmd_track "$@" ;;
    peers) shift; require_cmd jq; cmd_peers "$@" ;;
    export | apply) not_implemented "$1" ;;
    "") usage >&2; exit 2 ;;
    *) printf 'startkin: unknown command: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
