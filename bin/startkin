#!/usr/bin/env bash
# startkin: dispatcher. Subcommands are scan, adopt, track, export, apply, rollback, peers; see `startkin --help` and docs/engine.md.
set -uo pipefail

STARTKIN_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export STARTKIN_ROOT
# shellcheck source=../lib/common.sh
source "$STARTKIN_ROOT/lib/common.sh"
# shellcheck source=../lib/machine.sh
source "$STARTKIN_ROOT/lib/machine.sh"
# shellcheck source=../lib/registry.sh
source "$STARTKIN_ROOT/lib/registry.sh"
# shellcheck source=../lib/scan.sh
source "$STARTKIN_ROOT/lib/scan.sh"
# shellcheck source=../lib/ui.sh
source "$STARTKIN_ROOT/lib/ui.sh"
# shellcheck source=../lib/adopt.sh
source "$STARTKIN_ROOT/lib/adopt.sh"
# shellcheck source=../lib/track.sh
source "$STARTKIN_ROOT/lib/track.sh"
# shellcheck source=../lib/peers.sh
source "$STARTKIN_ROOT/lib/peers.sh"
# shellcheck source=../lib/export.sh
source "$STARTKIN_ROOT/lib/export.sh"
# shellcheck source=../lib/drift.sh
source "$STARTKIN_ROOT/lib/drift.sh"
# shellcheck source=../lib/target.sh
source "$STARTKIN_ROOT/lib/target.sh"
# shellcheck source=../lib/apply.sh
source "$STARTKIN_ROOT/lib/apply.sh"
# shellcheck source=../lib/backup.sh
source "$STARTKIN_ROOT/lib/backup.sh"
# shellcheck source=../lib/apply_more.sh
source "$STARTKIN_ROOT/lib/apply_more.sh"

usage() {
  cat <<'EOF'
Usage: startkin <command> [options]

Commands:
  scan [--json | --report] [--probe]
                  Detect what was added after the Omarchy install (--json: print the manifest;
                  --report: print provenance counts instead;
                  --probe: also run unowned CLI binaries with --version/--help, off by default)
  adopt           Confirm where untraced items came from (see docs/adopt.md)
  track install  Run an install and record its source, version and date
  export [--out FILE] [--from SNAPSHOT]
                  Write the manifest to stdout or FILE (mode 600); --from re-exports a saved snapshot
                  (secrets-gated either way, see docs/engine.md)
  apply MANIFEST | --from-peer PEER [--dry-run] [--yes] [--only IDS]
                  Reproduce a manifest on this machine: packages, tools, plugins, config (diff, backup), services
                  (--dry-run shows the commands and runs nothing; see `startkin apply --help`)
  rollback [ID|latest] [--yes] [--dry-run] | --list
                  Undo an apply run: restore the config files it replaced from its backup
  peers [--json] [--no-probe]
                  List Tailscale peers (Linux) and the startkin version each online one runs
  peers fetch PEER
                  Print PEER's manifest (runs `startkin scan --json` over SSH)

Options:
  --version       Print the version
  -h, --help      Print this help

Implemented so far: --version, --help, `scan --json`, adopt, track, export, peers, apply (packages, tools, plugins, config, services), rollback.
EOF
}

not_implemented() { die -c 2 "$1: not implemented"; }

cmd_scan() {
  local json=0 report=0 a
  for a in "$@"; do
    case $a in
      --json) json=1 ;;
      --report) report=1 ;;
      --probe) export STARTKIN_PROBE=1 ;;
      *) die -c 2 "scan: unknown option: $a" ;;
    esac
  done
  ((json && report)) && die -c 2 "scan: --json and --report are exclusive"
  ((json || report)) || not_implemented scan
  require_cmd jq
  if ((report)); then
    local rc=0
    scan_collect | prov_report
    rc=${PIPESTATUS[0]}
    return "$rc"
  fi
  scan_manifest
}

main() {
  case ${1:-} in
    --version) echo "startkin $(version)" ;;
    -h | --help) usage ;;
    scan) shift; cmd_scan "$@" ;;
    adopt) shift; cmd_adopt "$@" ;;
    track) shift; cmd_track "$@" ;;
    peers) shift; require_cmd jq; cmd_peers "$@" ;;
    export) shift; cmd_export "$@" ;;
    apply) shift; cmd_apply "$@" ;;
    rollback) shift; require_cmd jq; cmd_rollback "$@" ;;
    "") usage >&2; exit 2 ;;
    *) printf 'startkin: unknown command: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
